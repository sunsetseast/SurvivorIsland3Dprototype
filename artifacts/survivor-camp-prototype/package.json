{
  "name": "@workspace/survivor-camp-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs",
    "preview:standalone": "node scripts/build-standalone.mjs",
    "qa:tribal": "node scripts/tribal-qa.mjs",
    "qa:living-camp": "node scripts/living-camp-qa.mjs",
    "assets:regenerate": "node ../../tools/blender/regenerate.mjs",
    "assets:validate": "node ../../tools/blender/validate.mjs",
    "qa:assets": "node scripts/sanctuary-review.mjs && node scripts/sanctuary-loading-qa.mjs",
    "qa:heroes": "node scripts/hero-review.mjs",
    "qa:railay": "node scripts/railay-qa.mjs",
    "qa:railay-loading": "node scripts/railay-loading-qa.mjs",
    "world:bake": "node --import tsx scripts/bake-railay.mjs",
    "qa:tonsai": "node scripts/tonsai-qa.mjs",
    "qa:tonsai-gameplay": "node scripts/tonsai-gameplay-qa.mjs",
    "qa:tonsai-loading": "node scripts/tonsai-loading-qa.mjs",
