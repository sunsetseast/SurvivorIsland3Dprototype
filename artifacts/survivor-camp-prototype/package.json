    "qa:tonsai-hero-gameplay": "node scripts/hero-gameplay-qa.mjs",
    "qa:tonsai-hero-loading": "node scripts/hero-loading-qa.mjs",
    "qa:mobile-sprint": "node scripts/mobile-sprint-qa.mjs",
    "qa:mobile-sprint:webkit": "SPRINT_BROWSER=webkit SPRINT_PORT=5199 SPRINT_EVIDENCE=../../docs/mobile-controls/evidence/webkit node scripts/mobile-sprint-qa.mjs",
    "qa:connected-world": "node scripts/connected-world-qa.mjs",
    "qa:flagship-camp": "node scripts/flagship-camp-qa.mjs",
    "qa:expansion": "node scripts/expansion-qa.mjs",
    "qa:expansion-metrics": "node --import tsx scripts/expansion-metrics.mjs",
    "assets:refine": "node --import tsx ../../tools/camp/refinement/build.mts && node --import tsx ../../tools/camp/refinement/migrate.mts",
    "world:bake-camp": "node --import tsx scripts/bake-camp-navigation.mjs",
    "qa:refinement": "node scripts/refinement-qa.mjs",
    "qa:reconstruction": "node scripts/reconstruction-qa.mjs",
    "assets:reconstruction": "python3 ../../tools/camp/reconstruction/textures.py && node --import tsx ../../tools/camp/reconstruction/build.mts",
    "qa:atmosphere": "node scripts/atmosphere-qa.mjs",
    "qa:atmosphere-integration": "node scripts/atmosphere-integration.mjs",
    "qa:sky-motion": "node scripts/sky-motion-qa.mjs",
    "assets:clouds": "python3 ../../tools/camp/atmosphere/clouds.py"
